{
  "name": "@linkiez/dxf-renew",
  "version": "9.0.0",
  "description": "DXF parser for node/browser",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "packageManager": "yarn@4.12.0",
  "bin": {
    "dxf-to-svg": "lib/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile:ts": "tsc",
    "compile": "node build.mjs",
    "build": "npm run compile",
    "watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "dist": "esbuild src/index.ts --bundle --platform=browser --format=iife --global-name=dxf --outfile=dist/dxf.js",
    "lint": "eslint src",
    "quality:gate": "npx --yes fallow@latest audit --ci",
    "clean": "rimraf dist/ lib/",
    "prepublishOnly": "npm run lint && npm run type-check && npm run test && npm run clean && npm run build && npm run dist",
    "prettier": "prettier --write .",
    "test": "npm run test:unit",
    "test:functional": "cd test/functional && vite --port 8030 --open /toSVG.html",
    "test:unit": "mocha --require tsx --extensions .ts \"test/unit/**/*.test.ts\"",
    "test:integration": "yarn test:integration:browser",
    "test:integration:node": "mocha --require tsx --extensions .ts \"test/integration/**/*.test.ts\"",
    "test:integration:browser": "yarn dist && playwright test",
    "test:unit:watch": "npm run test:unit -- --watch",
    "validate:fixtures": "bash -lc 'if [ -x ./.venv-ezdxf/bin/python ]; then ./.venv-ezdxf/bin/python tools/ezdxf_validate_fixtures.py --fail-on-audit-errors; else python3 tools/ezdxf_validate_fixtures.py --fail-on-audit-errors; fi'",
    "prepare": "husky",
    "semantic-release": "semantic-release",
    "commit": "git-cz",
    "nest": "tsx src/cli-nest.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linkiez/DXF-Renewed.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "DXF",
    "Parser",
    "SVG"
  ],
  "author": "Ben Nortier <ben@bjnortier.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/linkiez/DXF-Renewed/issues"
  },
  "homepage": "https://github.com/linkiez/DXF-Renewed",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/lodash": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "expect": "^30.5.1",
    "husky": "^9.1.7",
    "mocha": "^12.0.1",
    "prettier": "^3.9.7",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "lodash": "^4.18.1",
    "rxjs": "^7.8.2",
    "vecks": "^3.9.2",
    "zod": "^4.6.5"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "standard": {
    "globals": [
      "describe",
      "it",
      "before",
      "beforeEach",
      "after"
    ],
    "ignore": [
      "lib/",
      "dist/"
    ]
  }
}
